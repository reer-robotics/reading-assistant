{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reer-robotics/reading-assistant/schemas/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "origin",
          "authors",
          "issued",
          "version",
          "maturity",
          "url",
          "synthetic",
          "tags",
          "access",
          "passages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "origin": {
            "enum": [
              "internal",
              "curated_external"
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 20
          },
          "issued": {
            "type": "string",
            "maxLength": 40
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maturity": {
            "enum": [
              "observation",
              "peer_validated",
              "approved",
              "external_reference"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "synthetic": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            },
            "maxItems": 30
          },
          "access": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "passages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "locator",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              }
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      },
      "maxItems": 500
    }
  }
}
