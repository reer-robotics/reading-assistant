{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reer-robotics/reading-assistant/schemas/recommendations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_sha256",
    "generated_at",
    "mode",
    "paragraphs",
    "recommendations",
    "workflow",
    "notice"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "lexical",
        "ollama"
      ]
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "color",
          "text",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "enum": [
              "teal",
              "violet",
              "amber",
              "blue",
              "rose",
              "olive"
            ]
          },
          "text": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passage_id",
          "label",
          "color",
          "rank",
          "kind",
          "reason",
          "caveat",
          "score",
          "assessment",
          "source",
          "evidence",
          "citation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "passage_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "suggested_reading",
              "possible_citation",
              "possible_conflict"
            ]
          },
          "reason": {
            "type": "string"
          },
          "caveat": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "assessment": {
            "enum": [
              "lexical",
              "model_suggestion"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "origin",
              "authors",
              "issued",
              "version",
              "maturity",
              "url",
              "synthetic"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "origin": {
                "enum": [
                  "internal",
                  "curated_external"
                ]
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "maxItems": 20
              },
              "issued": {
                "type": "string",
                "maxLength": 40
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "maturity": {
                "enum": [
                  "observation",
                  "peer_validated",
                  "approved",
                  "external_reference"
                ]
              },
              "url": {
                "type": "string",
                "maxLength": 2000
              },
              "synthetic": {
                "type": "boolean"
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "locator",
              "text",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "locator": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "marker",
              "text",
              "markdown",
              "style",
              "missing_fields"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "marker": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "markdown": {
                "type": "string"
              },
              "style": {
                "const": "source-note-v1"
              },
              "missing_fields": {
                "type": "array",
                "items": {
                  "enum": [
                    "authors",
                    "issued"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "steps",
        "model",
        "catalog_sha256",
        "skill_version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog_sha256": {
          "type": "string"
        },
        "skill_version": {
          "type": "integer"
        }
      }
    },
    "notice": {
      "type": "string"
    }
  }
}
